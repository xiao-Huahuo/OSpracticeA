@startuml
!pragma layout smetana
title 图 2  exec 刚结束，echo 还没执行第一条指令
skinparam shadowing false
skinparam backgroundColor white
skinparam linetype ortho
skinparam nodesep 18
skinparam ranksep 22

package "① 进程表" {
  rectangle "init\nstate：睡眠或可运行\nparent：无\npagetable：PT_init，sz：自己的大小\nofile[0..2]：控制台" as Init
  rectangle "Shell\nstate：在 wait 中睡眠\nparent：init\npagetable：PT_sh，sz：Shell 的大小\nofile[0..2]：控制台" as Sh
  rectangle "echo\nstate：RUNNING，准备返回用户态\nparent：Shell\npagetable：PT_echo，sz：新映像和栈\nofile[0..2]：沿用控制台\ntrapframe：TF_echo，epc 是 echo 入口" as E
  E --> Sh : parent
  Sh --> Init : parent
}

package "② echo 的页表 PT_echo" {
  rectangle "L2 根" as L2
  rectangle "低地址 L1" as LowL1
  rectangle "低地址 L0" as LowL0
  rectangle "高地址 L1" as HighL1
  rectangle "高地址 L0" as HighL0
  rectangle "低地址用户区\n代码和数据：VA 0 到映像末，R-X-U / RW-U\n堆：从 sz 向上，初始尚未分配\nguard：sz-2页 到 sz-1页，U=0\n用户栈：sz-1页 到 sz，RW-U" as Low
  rectangle "高地址两页\nTRAPFRAME：MAXVA-2页 到 MAXVA-1页，RW-、U=0\n映到 TF_echo 物理页\nTRAMPOLINE：MAXVA-1页 到 MAXVA，R-X、U=0" as High
  L2 --> LowL1
  LowL1 --> LowL0
  LowL0 --> Low : 低地址映射
  L2 --> HighL1
  HighL1 --> HighL0
  HighL0 --> High : 固定映射
}

package "③ 标准输出 fd 1" {
  rectangle "Shell.ofile[1]\necho.ofile[1]" as FD
  rectangle "同一个 struct file\nFD_DEVICE，ref 至少 2\nmajor=CONSOLE" as File
  rectangle "控制台 inode\nT_DEVICE" as Inode
  rectangle "devsw[CONSOLE].write\n→ consolewrite → UART" as Device
  FD --> File
  File --> Inode : ip
  File --> Device : major
}

E --> L2 : pagetable
E --> FD : ofile[1]

note bottom of E
  想一想：exec 换了程序和用户页表，
  echo 的 PID、parent、打开的 fd 仍是原来的。
end note

@enduml
